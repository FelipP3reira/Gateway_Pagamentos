# Banco de trabalho (o docker-compose sobe o Postgres na 5440).
DATABASE_URL=postgres://pagamentos:pagamentos@localhost:5440/pagamentos
# desenvolvimento | teste | producao
AMBIENTE=desenvolvimento
PORTA=3011
# trace | debug | info | warn | error
NIVEL_LOG=info

# Chave da API entre serviços (a loja manda em Authorization: Bearer <chave>).
# Obrigatória em produção, com 32+ caracteres. Gere com: openssl rand -hex 32
# Vazia em desenvolvimento = API aberta.
GATEWAY_API_KEY=
# Só durante a rotação: a chave antiga continua valendo até a loja trocar.
GATEWAY_API_KEY_ANTERIOR=

# true atrás do proxy da plataforma (Railway/Render/Fly), para o rate limit ver o
# IP real do cliente. Mantenha false rodando local sem proxy.
CONFIAR_NO_PROXY=false
# Requisições por minuto, por IP, nas rotas públicas de webhook.
LIMITE_WEBHOOKS_POR_MINUTO=120

# Segredo do provider fake e do PIX simulado (HMAC dos webhooks de teste).
# Obrigatório fora de produção; em produção o fake e o /pix/* simulado nem sobem.
FAKE_WEBHOOK_SECRET=segredo-fake-dev

# Mercado Pago (Suas integrações → Credenciais). Use as credenciais de TESTE em
# desenvolvimento e Preview; as de produção só no gateway de produção. Sem token,
# o adaptador fica desligado. Com token, o segredo do webhook é obrigatório.
MERCADOPAGO_ACCESS_TOKEN=
# Suas integrações → Webhooks → assinatura secreta.
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública HTTPS do nosso webhook, enviada em cada cobrança (opcional se já
# configurada no painel). Ex.: https://gateway.exemplo.com/webhooks/mercadopago
MERCADOPAGO_URL_NOTIFICACAO=
MERCADOPAGO_PARCELAS_MAXIMAS=12

# Stripe em modo teste (sandbox). OPCIONAL: sem as chaves, o adaptador Stripe
# fica desligado e o provider fake cobre o fluxo. NUNCA use chaves de produção.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
