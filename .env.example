# Banco de trabalho (o docker-compose sobe o Postgres na 5440).
DATABASE_URL=postgres://pagamentos:pagamentos@localhost:5440/pagamentos
AMBIENTE=desenvolvimento
PORTA=3011

# Segredo do provider fake para assinar/verificar webhooks (HMAC). Em produção
# seria um segredo forte por provedor; aqui há um valor de desenvolvimento.
FAKE_WEBHOOK_SECRET=segredo-fake-dev

# Stripe em modo teste (sandbox). OPCIONAL: sem as chaves, o adaptador Stripe
# fica desligado e o provider fake cobre o fluxo. NUNCA use chaves de produção.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
